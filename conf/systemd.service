[Unit]
Description=Calagopus Panel — game server management panel
Documentation=https://calagopus.com/docs/panel/
After=network.target postgresql.service redis.service redis-server.service

[Service]
Type=simple
User=__APP__
Group=__APP__

# Working directory must be set to install_dir so the panel finds .env here
WorkingDirectory=__INSTALL_DIR__

# Load environment from .env in install_dir (the panel also reads it natively,
# but EnvironmentFile ensures all vars are available to the process)
EnvironmentFile=__INSTALL_DIR__/.env

# The calagopus-panel APT package installs the binary here.
# ASSUMPTION: Verified path is /usr/bin/calagopus-panel — adjust if the
# upstream package places it elsewhere (check: dpkg -L calagopus-panel | grep bin)
ExecStart=/usr/bin/calagopus-panel

# Write panel stdout to the dedicated log file
StandardOutput=append:/var/log/__APP__/__APP__.log
StandardError=inherit

# Restart policy — restart on failure with backoff
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# =====================================================================
# SECURITY HARDENING
# Appropriate for a Rust binary web application running as a system user.
# =====================================================================

# Prevent privilege escalation
NoNewPrivileges=yes

# Private /tmp
PrivateTmp=yes

# No access to physical devices
PrivateDevices=yes

# Allow only the address families the panel actually needs:
#   AF_INET / AF_INET6: HTTP listener + outbound connections (PostgreSQL, Redis, Wings)
#   AF_UNIX: PostgreSQL socket fallback
#   AF_NETLINK: needed by tokio/rustls for async I/O on Linux
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Isolate namespace views
RestrictNamespaces=yes

# Deny real-time scheduling
RestrictRealtime=yes

# Device policy
DevicePolicy=closed

# Protect system resources
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes

# Restrict to native system call architecture only
SystemCallArchitectures=native

# Deny syscall groups that a web panel has no business calling:
# @clock @debug @module @mount @obsolete @reboot @setuid @swap
# @cpu-emulation @privileged
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation @privileged

# Drop dangerous capabilities not needed by a web application
CapabilityBoundingSet=~CAP_RAWIO CAP_MKNOD
CapabilityBoundingSet=~CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE
CapabilityBoundingSet=~CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_MODULE CAP_SYS_PACCT
CapabilityBoundingSet=~CAP_LEASE CAP_LINUX_IMMUTABLE CAP_IPC_LOCK
CapabilityBoundingSet=~CAP_BLOCK_SUSPEND CAP_WAKE_ALARM
CapabilityBoundingSet=~CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=~CAP_MAC_ADMIN CAP_MAC_OVERRIDE
CapabilityBoundingSet=~CAP_NET_ADMIN CAP_NET_BROADCAST CAP_NET_RAW
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYSLOG

[Install]
WantedBy=multi-user.target
