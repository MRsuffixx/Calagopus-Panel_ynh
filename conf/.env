# Calagopus Panel environment configuration
# Generated by the YunoHost package at install/upgrade time.
# DO NOT edit this file manually — use: yunohost app config set calagopus-panel
# Changes made here may be overwritten on the next upgrade.
#
# !! SECURITY CRITICAL: APP_ENCRYPTION_KEY !!
# This key is used to encrypt stored secrets in the database.
# If it is changed or lost, all encrypted data becomes permanently
# unreadable. This file MUST be backed up and restored byte-for-byte.

# =============================================================================
# DATABASE
# =============================================================================

# Full PostgreSQL connection string (provisioned by YunoHost resource system)
DATABASE_URL=__DATABASE_URL__

# Run database migrations automatically on startup (safe for single-instance)
DATABASE_MIGRATE=true

# =============================================================================
# REDIS / CACHE
# =============================================================================

# Redis connection mode: "redis" (standalone) or "sentinel" (HA)
# YunoHost uses a standalone Redis instance, so we always use "redis" here.
REDIS_MODE=redis

# Redis connection URL using a dedicated database index to isolate instances
REDIS_URL=__REDIS_URL__

# =============================================================================
# NETWORK
# =============================================================================

# Bind only to localhost — NGINX handles all external traffic via reverse proxy
BIND=127.0.0.1

# Port allocated by YunoHost's ports resource
PORT=__PORT__

# =============================================================================
# APPLICATION
# =============================================================================

# This instance owns background jobs (appropriate for single-node YunoHost)
APP_PRIMARY=true

# Debug mode — false in production. Toggle via: yunohost app config set __APP__
APP_DEBUG=__APP_DEBUG__

# Proxy Wings traffic through the panel — false for panel-only install.
# Enabling this requires a Wings node to be installed separately.
# See README.md for information about the AIO variant.
APP_ENABLE_WINGS_PROXY=false

# Disable the bundled React frontend — false: we want the UI
APP_DISABLE_FRONTEND=false

# Cache decrypted secrets in Redis — false is the safer default.
# Enabling reduces DB load but means secrets are briefly in Redis memory.
APP_USE_DECRYPTION_CACHE=false

# In-memory cache for single-node deployment (upstream default)
APP_USE_INTERNAL_CACHE=true

# Trust only the local NGINX reverse proxy
APP_TRUSTED_PROXIES=127.0.0.1

# =============================================================================
# LOGGING
# =============================================================================

# Directory for panel log files (created with correct ownership at install time)
APP_LOG_DIRECTORY=/var/log/__APP__

# =============================================================================
# ENCRYPTION
# =============================================================================

# SECURITY CRITICAL — see top-of-file warning
APP_ENCRYPTION_KEY=__ENCRYPTION_KEY__

# =============================================================================
# IDENTITY
# =============================================================================

# Instance label shown in the panel footer and Sentry reports
SERVER_NAME=__SERVER_NAME__

# =============================================================================
# OPTIONAL — Error tracking (Sentry)
# =============================================================================

# Leave empty to disable. Set via: yunohost app config set __APP__ sentry_url
#SENTRY_URL=
