#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# Settings automatically loaded as bash vars.
# In upgrade context:
#   - Resources are automatically provisioned/updated/deleted (per manifest)
#   - A safety backup is automatically created before this script runs;
#     it will be restored automatically if this script fails.

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# If encryption_key was not previously stored (pre-1.0 installs), it means
# the old install used a different config layout — set a default to avoid
# a broken .env. (Should not occur for fresh installs following this package.)
ynh_app_setting_set_default --key=encryption_key --value="$(ynh_string_random --length=32)"
ynh_app_setting_set_default --key=server_name --value="$app on $domain"
ynh_app_setting_set_default --key=sentry_url --value=""
ynh_app_setting_set_default --key=app_debug --value="false"
ynh_app_setting_set_default --key=redis_db --value="0"

#=================================================
# ENSURE CALAGOPUS APT REPO IS STILL REGISTERED
#=================================================
ynh_script_progression "Ensuring Calagopus APT repository is current..."

# Re-import key and source list in case they were removed or corrupted
if [ ! -f "$repo_key_path" ]; then
    curl --silent --show-error --location "$repo_key_url" \
        | gpg --dearmor > "$repo_key_path"
    chmod 644 "$repo_key_path"
fi

if [ ! -f "/etc/apt/sources.list.d/calagopus.list" ]; then
    echo "$repo_source_string" > "/etc/apt/sources.list.d/calagopus.list"
fi

apt-get update --quiet

#=================================================
# UPGRADE CALAGOPUS PANEL BINARY
#=================================================
ynh_script_progression "Upgrading $app package..."

DEBIAN_FRONTEND=noninteractive apt-get install --quiet --yes --only-upgrade "$pkg_name"

#=================================================
# ENSURE LOG DIRECTORY EXISTS
#=================================================

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"
chmod 750 "/var/log/$app"

#=================================================
# UPDATE CONFIGURATION FILES
#=================================================
ynh_script_progression "Updating $app's configuration files..."

# Re-read saved settings so the .env reflects the current state
encryption_key=$(ynh_app_setting_get --key=encryption_key)
server_name=$(ynh_app_setting_get --key=server_name)
sentry_url=$(ynh_app_setting_get --key=sentry_url)
app_debug=$(ynh_app_setting_get --key=app_debug)
redis_db=$(ynh_app_setting_get --key=redis_db)

redis_url="redis://127.0.0.1:6379/$redis_db"
database_url="postgresql://${db_user}:${db_pwd}@localhost:5432/${db_name}"

# Render fresh .env — ynh_config_add automatically backs up the previous file
# if it was manually modified, and warns the admin
ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

# Idempotent re-application of all system config — same as install section
ynh_config_add_nginx

ynh_config_add_systemd

# Re-register service (idempotent; overrides description if flags changed)
yunohost service add "$app" \
    --description="Calagopus Panel — game server management panel" \
    --log="/var/log/$app/$app.log"

ynh_config_add_logrotate "/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Listening on"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
