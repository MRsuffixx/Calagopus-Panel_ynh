#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# In backup and restore scripts, _common.sh is sourced via the settings path
# because they run in a different execution context.
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

# N.B.: ynh_backup calls are declarations only — the actual copying to the
# archive tar.gz happens in the YunoHost core AFTER this script completes.
# These calls are therefore nearly instantaneous.

#=================================================
# BACKUP THE APP MAIN DIR (includes .env with encryption key!)
#=================================================

# !! SECURITY CRITICAL — ENCRYPTION KEY !!
# The .env file inside $install_dir contains APP_ENCRYPTION_KEY.
# This key encrypts all stored credentials in the database.
# If this backup is missing or the key is modified/replaced on restore,
# ALL ENCRYPTED DATA BECOMES PERMANENTLY UNREADABLE and existing Calagopus
# users will be permanently locked out of their accounts/servers.
# This file MUST be restored byte-for-byte. See the restore script.
ynh_backup "$install_dir"

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================

# NGINX virtualhost configuration
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

# systemd service unit
ynh_backup "/etc/systemd/system/$app.service"

# logrotate configuration
ynh_backup "/etc/logrotate.d/$app"

#=================================================
# BACKUP THE POSTGRESQL DATABASE
#=================================================
ynh_print_info "Backing up the PostgreSQL database..."

# ynh_pg_dump_db creates a SQL dump of the database.
# The dump file is placed in the backup archive by the core.
ynh_pg_dump_db > "db.sql"

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
