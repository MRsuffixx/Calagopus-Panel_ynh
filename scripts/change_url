#!/bin/bash

## change_url is called only when an actual change to domain or path is detected.
## New values: $domain, $path (or $new_domain, $new_path for explicitness)
## Old values: $old_domain, $old_path

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# IMPORTANT NOTE ON SUB-PATH SUPPORT:
# Calagopus Panel is a Vite/React SPA. Many Vite SPAs hardcode base: '/' in
# their build configuration, which means they only work correctly when served
# from the root of a domain, not from a sub-path like /panel.
#
# ASSUMPTION: Sub-path installs may produce a broken UI if the upstream build
# does not respect the sub-path prefix for static asset URLs.
#
# If the admin has chosen a non-root path ("/"), this package will update
# the NGINX config regardless, but the UI may be broken. To restrict installs
# to root-only, set `path = "/"` as a fixed value in manifest.toml's [install]
# section (remove the [install.path] question). See §3.5 of the packaging spec.
#
# Until this is verified against the live APT-installed binary, we allow
# path changes but document the caveat here and in README.md.

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progression "Updating NGINX web server configuration..."

# This helper handles domain and path changes in the NGINX config correctly.
# It removes the old virtualhost conf, renders a new one from the template,
# and reloads NGINX.
ynh_config_change_url_nginx

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Change of URL completed for $app"
