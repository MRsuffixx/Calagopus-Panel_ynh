#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# Resource-provisioned variables automatically available as bash vars:
#   $app           — app id (e.g. "calagopus-panel" or "calagopus-panel__2")
#   $domain        — chosen domain
#   $path          — chosen URL path
#   $install_dir   — /var/www/$app  (from install_dir resource)
#   $port          — allocated port  (from ports resource)
#   $db_name       — postgresql db name (from database resource)
#   $db_user       — postgresql role   (from database resource)
#   $db_pwd        — postgresql password (from database resource)
#   $init_main_permission — visitor group choice

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# Generate APP_ENCRYPTION_KEY — 32 random characters.
# !! SECURITY CRITICAL !!
# This key encrypts stored secrets in the database. If it is lost or changed,
# all encrypted data becomes permanently unreadable and existing users/servers
# will be locked out. It MUST be stored in the YunoHost settings database and
# backed up byte-for-byte. See the backup script for the corresponding comment.
encryption_key=$(ynh_string_random --length=32)
ynh_app_setting_set --key=encryption_key --value="$encryption_key"

# Set server name for operator clarity in multi-instance setups
server_name="$app on $domain"
ynh_app_setting_set --key=server_name --value="$server_name"

# Optional Sentry DSN — empty by default; admin can set via config panel
sentry_url=""
ynh_app_setting_set --key=sentry_url --value="$sentry_url"

# Debug mode — false in production; togglable via config panel
app_debug="false"
ynh_app_setting_set --key=app_debug --value="$app_debug"

#=================================================
# CREATE LOG DIRECTORY
#=================================================
ynh_script_progression "Creating log directory..."

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"
chmod 750 "/var/log/$app"

#=================================================
# APP INITIAL CONFIGURATION — Write .env
#=================================================
ynh_script_progression "Writing $app configuration..."

# Build REDIS_URL from YunoHost's built-in Redis instance.
# YunoHost core provisions Redis on localhost:6379 with no password.
# Database index is derived from the app id hash to avoid key collisions
# between multiple instances (0-15 are available in Redis).
# ASSUMPTION: YunoHost's Redis is compatible with the rustis client used by
# Calagopus. Plain Redis (REDIS_MODE=redis) is explicitly supported upstream.
redis_db=$(echo -n "$app" | md5sum | tr -dc '0-9' | head -c 1)
# Ensure index is 0–15
redis_db=$((redis_db % 16))
redis_url="redis://127.0.0.1:6379/$redis_db"
ynh_app_setting_set --key=redis_db --value="$redis_db"

# Build DATABASE_URL from the resource-provisioned PostgreSQL credentials
database_url="postgresql://${db_user}:${db_pwd}@localhost:5432/${db_name}"

# Render the .env file from the template in conf/.env
# Template placeholders (__FOO__) are replaced with actual values by ynh_config_add
ynh_config_add --template=".env" --destination="$install_dir/.env"

# Restrict access — .env contains the encryption key and DB password
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config using conf/nginx.conf template
ynh_config_add_nginx

# Create a dedicated systemd service unit using conf/systemd.service template
ynh_config_add_systemd

# Register the service with YunoHost so it appears in the webadmin
yunohost service add "$app" \
    --description="Calagopus Panel — game server management panel" \
    --log="/var/log/$app/$app.log"

# Configure logrotate for the panel's log directory
ynh_config_add_logrotate "/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start the panel; DATABASE_MIGRATE=true (in .env) runs db migrations on boot
ynh_systemctl --service="$app" --action="start" --wait_until="Listening on"

#=================================================
# HEALTH CHECK
#=================================================
ynh_script_progression "Verifying $app is reachable..."

# Give the process a moment to bind the port
sleep 3

# Check that the port is actually listening
if ! ss -tlnp 2>/dev/null | grep -q ":${port}"; then
    ynh_print_warn "WARNING: $app does not appear to be listening on port $port yet."
    ynh_print_warn "Check logs: journalctl -u $app --no-pager -n 50"
else
    ynh_print_info "$app is listening on port $port."
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"

ynh_print_info "
==========================================================================
Calagopus Panel has been installed successfully!

IMPORTANT — First-run setup required:
  Open your browser and navigate to:
    https://$domain$path

  You will see the Calagopus Out-Of-Box Experience (OOBE) wizard.
  Follow the on-screen instructions to create your first admin account.

Note: YunoHost accounts are NOT linked to Calagopus accounts. This is
intentional. Calagopus manages its own authentication independently.
==========================================================================
"
