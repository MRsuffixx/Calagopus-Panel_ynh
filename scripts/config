#!/bin/bash

# config script for Calagopus Panel
# Handles reading/writing of runtime-configurable settings to/from the .env file.
# Most bindings are handled automatically by ynh_app_config_run via bind= in
# config_panel.toml. Custom getters/setters are only defined where needed.

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# RETRIEVE ARGUMENTS
#=================================================

install_dir=$(ynh_app_setting_get --key=install_dir)
app=$(ynh_app_setting_get --key=app)

#=================================================
# SPECIFIC SETTERS FOR TOML SHORT KEYS
#=================================================

# After any config panel change, we need to restart the service so the
# new .env values take effect. The config_panel.toml's services = ["__APP__"]
# declaration handles this automatically — YunoHost will reload-or-restart
# the service after a successful apply. No manual restart needed here.

#=================================================
set__app_debug() {
    # Write the new value to settings AND to the .env file
    # ynh_app_config_run handles this via bind= in the TOML, so this
    # custom setter is only needed if extra logic is required.
    ynh_app_setting_set --key=app_debug --value="$app_debug"
    ynh_replace \
        --match="^APP_DEBUG=.*" \
        --replace="APP_DEBUG=$app_debug" \
        --file="$install_dir/.env"
    ynh_store_file_checksum "$install_dir/.env"
}

set__sentry_url() {
    ynh_app_setting_set --key=sentry_url --value="$sentry_url"
    if [ -z "$sentry_url" ]; then
        # If empty, comment out the line so the panel treats it as unset
        ynh_replace \
            --match="^SENTRY_URL=.*" \
            --replace="#SENTRY_URL=" \
            --file="$install_dir/.env"
    else
        ynh_replace \
            --match="^#*SENTRY_URL=.*" \
            --replace="SENTRY_URL=$sentry_url" \
            --file="$install_dir/.env"
    fi
    ynh_store_file_checksum "$install_dir/.env"
}

#=================================================
ynh_app_config_run "$1"
