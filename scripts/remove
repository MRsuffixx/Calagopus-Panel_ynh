#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# Settings automatically loaded as bash vars:
#   $app, $domain, $path, $install_dir, $port, $db_name, $db_user, $db_pwd
#
# For remove operations, the core will deprovision every resource defined in
# the manifest AFTER this script runs. This includes removing $install_dir
# (and $data_dir if --purge was used) and dropping the PostgreSQL DB/role.
# So we only need to clean up what isn't covered by resources.

#=================================================
# REMOVE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

# Remove logrotate configuration
ynh_config_remove_logrotate

# Stop the service, remove it from YunoHost's service registry, and remove the unit
if ynh_hide_warnings yunohost service status "$app" > /dev/null; then
    yunohost service remove "$app"
fi
ynh_config_remove_systemd

# Remove the NGINX virtualhost configuration
ynh_config_remove_nginx

#=================================================
# REMOVE LOG DIRECTORY
#=================================================

ynh_safe_rm "/var/log/$app"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"
