#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers



#=================================================
# CREATE LOG DIRECTORY
#=================================================

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"
chmod 750 "/var/log/$app"

#=================================================
# RESTORE THE APP MAIN DIR (contains .env with encryption key!)
#=================================================
ynh_script_progression "Restoring the app main directory..."

# !! SECURITY CRITICAL — ENCRYPTION KEY !!
# The .env file inside $install_dir contains APP_ENCRYPTION_KEY.
# It MUST be restored byte-for-byte from the archive. If this key changes,
# all encrypted data in the database becomes permanently unreadable and
# Calagopus users/servers will be locked out. Do NOT regenerate the key here.
ynh_restore "$install_dir"

# Ensure permissions are correct after restore
chown -R "$app:$app" "$install_dir"
chmod 600 "$install_dir/.env"

#=================================================
# RESTORE THE POSTGRESQL DATABASE
#=================================================
ynh_script_progression "Restoring the PostgreSQL database..."

# The database and role are provisioned by the manifest resource before this
# script runs. We restore the dump into the fresh (empty) database.
ynh_pg_db_shell < "./db.sql"

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Restoring system configurations related to $app..."

# Restore the NGINX configuration
ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"

# Restore the systemd service unit and enable it
ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet
systemctl daemon-reload

# Re-register the service with YunoHost
yunohost service add "$app" \
    --description="Calagopus Panel — game server management panel" \
    --log="/var/log/$app/$app.log"

# Restore logrotate configuration
ynh_restore "/etc/logrotate.d/$app"

#=================================================
# RELOAD NGINX AND START THE APP SERVICE
#=================================================
ynh_script_progression "Reloading NGINX web server and $app's service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Listening on"
ynh_systemctl --service=nginx --action=reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"
